{
  // Cloudflare Worker of the Check game (architecture §4). Local: `pnpm --filter worker dev`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "check",
  "main": "src/index.ts",
  // Must stay supported by the workerd bundled with @cloudflare/vitest-pool-workers.
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "USER", "class_name": "UserDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" },
    ],
  },
  // SQLite-backed Durable Objects: available on the Workers Free plan as well as on Paid.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "UserDO", "LobbyDO"] }],
  // Not secret. Local Supabase (`supabase start`); overridden per environment at deployment.
  "vars": { "SUPABASE_URL": "http://127.0.0.1:54321" },
  "observability": { "enabled": true },
}
